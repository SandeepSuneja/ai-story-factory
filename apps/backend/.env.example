# Copy to .env and fill in locally; do not commit secrets.
FRONTEND_URL=http://localhost:5173
QWEN_SERVICE_URL=http://127.0.0.1:8090
HUNYUAN_SERVICE_URL=http://127.0.0.1:7861
TTS_SERVICE_URL=http://127.0.0.1:7862
ASSEMBLY_SERVICE_URL=http://127.0.0.1:7863
FLUX_SERVICE_URL=http://127.0.0.1:7860
IMAGE_STORAGE_DIR=
VIDEO_STORAGE_DIR=
AUDIO_STORAGE_DIR=
# Optional. Defaults to apps/backend/storage/projects
PROJECT_STORAGE_DIR=
# Optional. HTTP timeouts for local AI services (ms).
# Text/image services default to 30 minutes.
INFERENCE_HEADERS_TIMEOUT_MS=
INFERENCE_BODY_TIMEOUT_MS=
# CogVideoX generation defaults to 24 hours (long clips or slow CPU fallback).
HUNYUAN_HEADERS_TIMEOUT_MS=
HUNYUAN_BODY_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# RTX 4070 Super (12 GB VRAM) + 32 GB RAM — recommended Python service env
# Set these in each service terminal before `python server.py`, not in .env.
# ---------------------------------------------------------------------------
#
# PHASE 1 — Text (idea, story, script, prompts): Qwen only
#   QWEN_N_GPU_LAYERS=-1          # ~9 GB VRAM, fast
#   QWEN_CONTEXT_SIZE=8192
#
# PHASE 2 — Images: FLUX only (keep Qwen running; sequential offload shares VRAM)
#   FLUX_OFFLOAD_MODE=sequential  # default; safest on 12 GB
#   FLUX_IMAGE_WIDTH=720
#   FLUX_IMAGE_HEIGHT=480
#   FLUX_INFERENCE_STEPS=28
#   # Faster iteration:
#   # FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
#   # FLUX_INFERENCE_STEPS=4
#   # FLUX_GUIDANCE_SCALE=0
#
# PHASE 3 — Videos: stop FLUX first (Ctrl+C), then CogVideoX only
#   HUNYUAN_OFFLOAD_MODE=auto           # model cpu offload on 12 GB (~11 GB with VAE tiling)
#   HUNYUAN_VIDEO_WIDTH=720             # fixed for CogVideoX-5b-I2V (landscape)
#   HUNYUAN_VIDEO_HEIGHT=480            # must match FLUX output
#   HUNYUAN_NUM_FRAMES=49               # ~6 s at 8 fps (CogVideoX native length)
#   HUNYUAN_MAX_NUM_FRAMES=49
#   HUNYUAN_MIN_NUM_FRAMES=49
#   HUNYUAN_MAX_SCENE_DURATION=6
#   HUNYUAN_FPS=8
#   HUNYUAN_INFERENCE_STEPS=40
#   HUNYUAN_MAX_PROMPT_TOKENS=226
#   HUNYUAN_GUIDANCE_SCALE=6.0          # CogVideoX default
#   HUNYUAN_OFFLOAD_MODE=sequential     # slower fallback if model offload OOMs
#   # Optional: restart Qwen with QWEN_N_GPU_LAYERS=0 to free ~9 GB for video gen
#
# PowerShell example (video terminal, after stopping FLUX):
#   $env:HUNYUAN_OFFLOAD_MODE="auto"
#   $env:HUNYUAN_NUM_FRAMES="49"
#   $env:HUNYUAN_INFERENCE_STEPS="40"
#   python server.py
#
# PHASE 4 — Audio + assembly: no GPU needed (stop CogVideoX first)
#   TTS_BACKEND=auto                    # kokoro locally, edge-tts fallback
#   TTS_KOKORO_VOICE=af_heart           # narration voice (Kokoro)
#   TTS_EDGE_VOICE=en-US-AriaNeural     # fallback voice (Edge TTS)
#   # Terminal 1: cd apps/backend/tts-service && python server.py
#   # Terminal 2: cd apps/backend/assembly-service && python server.py
#   ASSEMBLY_SUBTITLES=true              # burn narration as subtitles (default)
#   ASSEMBLY_SUBTITLE_FONT_SIZE=22       # tuned for 720x480 landscape
#   ASSEMBLY_SUBTITLE_MARGIN_V=72

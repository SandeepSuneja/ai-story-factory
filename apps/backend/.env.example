# Copy to .env and fill in locally; do not commit secrets.
FRONTEND_URL=http://localhost:5173
QWEN_SERVICE_URL=http://127.0.0.1:8090
HUNYUAN_SERVICE_URL=http://127.0.0.1:7861
UPSCALE_SERVICE_URL=http://127.0.0.1:7864
TTS_SERVICE_URL=http://127.0.0.1:7862
FLUX_SERVICE_URL=http://127.0.0.1:7860
IMAGE_STORAGE_DIR=
VIDEO_STORAGE_DIR=
AUDIO_STORAGE_DIR=
# Optional. Defaults to apps/backend/storage/projects
PROJECT_STORAGE_DIR=
# Optional. HTTP timeouts for local AI services (ms).
# Text/image services default to 30 minutes.
INFERENCE_HEADERS_TIMEOUT_MS=
INFERENCE_BODY_TIMEOUT_MS=
# FLUX image generation defaults to 48 hours (slow GPUs or thermal throttling).
FLUX_HEADERS_TIMEOUT_MS=
FLUX_BODY_TIMEOUT_MS=
# Wan2.1 video generation defaults to 48 hours (long clips or slow CPU fallback).
HUNYUAN_HEADERS_TIMEOUT_MS=
HUNYUAN_BODY_TIMEOUT_MS=
# FP8 checkpoint (~16 GB download) is upcast to bf16 at load — cuDNN cannot run FP8 conv3d.
# HUNYUAN_PRECISION=fp8
# HUNYUAN_BASE_MODEL_ID=Wan-AI/Wan2.1-I2V-14B-480P-Diffusers
# HUNYUAN_FP8_TRANSFORMER_REPO=wangkanai/wan21-fp8-480p
# HUNYUAN_FP8_TRANSFORMER_FILE=diffusion_models/wan/wan21-i2v-480p-14b-fp8-e4m3fn.safetensors
# Set HUNYUAN_PRECISION=bf16 to use the full bf16 transformer from the base repo instead.

# ---------------------------------------------------------------------------
# RTX 4070 Super (12 GB VRAM) + 32 GB RAM — recommended Python service env
# Set these in each service terminal before `python server.py`, not in .env.
# ---------------------------------------------------------------------------
#
# PHASE 1 — Text (idea, story, script, prompts): Qwen only
#   QWEN_N_GPU_LAYERS=-1          # ~9 GB VRAM, fast
#   QWEN_CONTEXT_SIZE=8192
#
# PHASE 2 — Images: FLUX only (keep Qwen running; sequential offload shares VRAM)
#   FLUX_OFFLOAD_MODE=sequential  # default; safest on 12 GB
#   FLUX_IMAGE_WIDTH=832             # match Wan 480P output
#   FLUX_IMAGE_HEIGHT=480
#   FLUX_INFERENCE_STEPS=28
#   FLUX_CLIP_MAX_TOKENS=77        # CLIP text encoder limit; prompts are auto-compressed
#   # Faster iteration:
#   # FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
#   # FLUX_INFERENCE_STEPS=4
#   # FLUX_GUIDANCE_SCALE=0
#
# PHASE 3 — Videos: stop FLUX + Qwen first (Ctrl+C), then Wan2.1 I2V only
#   Close other apps to free system RAM — Wan 14B needs ~18 GB RAM headroom during load.
#   HUNYUAN_BASE_MODEL_ID=Wan-AI/Wan2.1-I2V-14B-480P-Diffusers
#   HUNYUAN_PRECISION=fp8                # default; ~16 GB FP8 transformer + faster inference
#   HUNYUAN_FP8_TRANSFORMER_REPO=wangkanai/wan21-fp8-480p
#   HUNYUAN_OFFLOAD_MODE=auto           # sequential on 12 GB VRAM (required for 14B bf16)
#   HUNYUAN_MAX_CPU_MEMORY_GB=18        # cap RAM during weight load on 32 GB systems
#   HUNYUAN_VIDEO_WIDTH=832             # Wan 480P native resolution
#   HUNYUAN_VIDEO_HEIGHT=480            # must match FLUX output
#   HUNYUAN_NUM_FRAMES=81               # default when duration omitted
#   HUNYUAN_MAX_NUM_FRAMES=97             # up to 6 s at 16 fps (4n+1)
#   HUNYUAN_MIN_NUM_FRAMES=49
#   HUNYUAN_VRAM_MAX_FRAMES=81            # 12 GB GPU: max frames to generate (export FPS stretched for 6 s)
#   HUNYUAN_MAX_SCENE_DURATION=6
#   HUNYUAN_FPS=16
#   HUNYUAN_INFERENCE_STEPS=20   # unset = 20 on 12 GB VRAM, 30 otherwise
#   HUNYUAN_MAX_PROMPT_TOKENS=96
#   HUNYUAN_GUIDANCE_SCALE=5.0          # Wan default
#   HUNYUAN_OFFLOAD_MODE=sequential     # slower fallback if model offload OOMs
#   # Optional: restart Qwen with QWEN_N_GPU_LAYERS=0 to free ~9 GB for video gen
#
# PowerShell example (video terminal, after stopping FLUX):
#   $env:HUNYUAN_OFFLOAD_MODE="auto"
#   $env:HUNYUAN_NUM_FRAMES="81"
#   $env:HUNYUAN_INFERENCE_STEPS="40"
#   python server.py
#
# PHASE 4 — 1080p upscale, narration audio, and final assembly (ffmpeg + TTS; no GPU)
#   ASSEMBLY_SERVICE_URL=http://127.0.0.1:7863
#   UPSCALE_SERVICE_URL=http://127.0.0.1:7864
#   TTS_BACKEND=auto                    # kokoro locally, edge-tts fallback
#   TTS_KOKORO_VOICE=af_heart           # narration voice (Kokoro)
#   TTS_EDGE_VOICE=en-US-AriaNeural     # fallback voice (Edge TTS)
#   TTS_EDGE_VOICE_HI=hi-IN-SwaraNeural # Hindi narration (Edge TTS; used when storyLanguage=hi)
#   # Terminal 1: cd apps/backend/upscale-service && python server.py
#   # Terminal 2: cd apps/backend/tts-service && python server.py
#   # Terminal 3: cd apps/backend/assembly-service && python server.py
#   ASSEMBLY_SUBTITLES=false             # burn-in subtitles disabled by default
#   ASSEMBLY_SUBTITLE_FONT_SIZE=28       # tuned for 1920x1080 output
#   ASSEMBLY_SUBTITLE_MARGIN_V=96
